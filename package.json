{
  "name": "piekarz",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": ["expo-camera"]
      },
      "android": {
        "exclude": ["expo-camera"]
      }
    }
  },
  "description": "Piekarz (Crust) — Apps4Brew: asystent domowego piekarza, procent piekarski, DDT, harmonogram wsteczny i profil zakwasu",
  "scripts": {
    "start": "expo start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs --kod src,app",
    "i18n:kontekst": "node scripts/check-i18n.mjs --kod src,app --zapisz-kontekst",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:metadane": "node scripts/sprawdz-metadane.mjs",
    "karty:ustawien": "node scripts/karty-ustawien.mjs",
    "lint": "eslint app src",
    "matrix:update": "node scripts/test-matrix.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "verify:matrix": "node scripts/test-matrix.mjs --check",
    "test:mutation": "stryker run",
    "check:mutation": "stryker run",
    "verify": "npm run typecheck && npm run check:i18n && npm run check:licenses && npm run check:size && npm run lint && npm run verify:native && npm run verify:matrix && npm test"
  },
  "dependencies": {
    "@apps4craft/ui": "github:lkarwowski494/apps4craft-ui",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-pluralrules": "^6.3.16",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-camera": "^57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "6.1.1",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-mail-composer": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-print": "^57.0.2",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.3",
    "expo-store-review": "~57.0.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@eslint/js": "10.0.1",
    "@react-native/jest-preset": "^0.86.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@types/jest": "^29.5.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.3.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "8.71.1"
  }
}
