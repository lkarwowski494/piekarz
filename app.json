{
  "expo": {
    "name": "Piekarz",
    "slug": "piekarz",
    "version": "1.0.0",
    "description": "Piekarz — asystent domowego piekarza, procent piekarski, 4-DDT, harmonogram wsteczny, baza zakwasu i radar sensoryczny. 100% Offline-First.",
    "primaryColor": "#1E4954",
    "scheme": "piekarz",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "locales": {
      "pl": "./languages/pl.json",
      "en": "./languages/en.json",
      "cs": "./languages/cs.json",
      "sk": "./languages/sk.json",
      "hu": "./languages/hu.json",
      "ro": "./languages/ro.json",
      "bg": "./languages/bg.json",
      "hr": "./languages/hr.json",
      "sl": "./languages/sl.json",
      "sr": "./languages/sr.json",
      "lt": "./languages/lt.json",
      "lv": "./languages/lv.json",
      "et": "./languages/et.json",
      "uk": "./languages/uk.json",
      "es": "./languages/es.json",
      "es-419": "./languages/es-419.json",
      "pt": "./languages/pt.json",
      "pt-BR": "./languages/pt-BR.json",
      "de": "./languages/de.json",
      "fr": "./languages/fr.json",
      "it": "./languages/it.json",
      "nl": "./languages/nl.json",
      "sv": "./languages/sv.json",
      "da": "./languages/da.json",
      "nb": "./languages/nb.json",
