{
  "expo": {
    "name": "Piekarz",
    "slug": "piekarz",
    "version": "0.1.0",
    "scheme": "piekarz",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apps4brew.baker",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSCameraUsageDescription": "Piekarz wymaga dostępu do aparatu, aby natychmiast zeskanować kod QR receptury od innego piekarza w 100% offline."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF9F5"
      },
      "package": "com.apps4brew.baker",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Piekarz wymaga dostępu do aparatu, aby natychmiast zeskanować kod QR receptury w 100% offline."
        }
      ]
    ]
  }
}
