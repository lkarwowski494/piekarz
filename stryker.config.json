{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text"],
  "testRunner": "jest",
  "jest": {
    "configFile": "jest.mutation.config.js"
  },
  "mutate": [
    "src/core/**/*.ts",
    "!src/core/**/__tests__/**",
    "!src/core/**/*.d.ts"
  ],
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "concurrency": 2,
  "timeoutMS": 30000,
  "coverageAnalysis": "off",
  "warnings": {
    "preprocessorErrors": false
  }
}
